<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF05080D" android:endColor="#F807101A" />
            <corners android:topRightRadius="22dp" android:bottomRightRadius="22dp" />
        </shape>
    </item>
    <item android:gravity="right" android:width="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00FF263E" android:centerColor="#FFFF263E" android:endColor="#00FF263E" />
        </shape>
    </item>
</layer-list>
