<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F20C1623" android:endColor="#F208101A" />
            <stroke android:width="1dp" android:color="#665F85A8" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FF354F" android:centerColor="#FFFF354F" android:endColor="#00FF354F" />
        </shape>
    </item>
</layer-list>
