<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#653A111D" android:endColor="#B20A1826" />
            <stroke android:width="2dp" android:color="#FFFF354F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:gravity="left" android:width="4dp" android:top="18dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFF354F" />
            <corners android:topRightRadius="3dp" android:bottomRightRadius="3dp" />
        </shape>
    </item>
</layer-list>
